# DriftGuard Core Configuration
DRIFTGUARD_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DRIFTGUARD_DRIFT_THRESHOLD=0.15

# Database Metadata Store Configuration
POSTGRES_USER=driftguard
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=driftguard
POSTGRES_HOST=driftguard-postgres
POSTGRES_PORT=5432

# Redis Feature Store Configuration
REDIS_HOST=driftguard-redis
REDIS_PORT=6379

# Advanced Observability (Optional)
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password

# MLflow Server Configuration (Optional)
MLFLOW_TRACKING_URI=http://driftguard-mlflow:5000
MLFLOW_EXPERIMENT_NAME=driftguard
# MLFLOW_ARTIFACT_ROOT=s3://your-aws-bucket/mlflow

# Prefect Server Configuration (Optional)
PREFECT_API_URL=http://driftguard-prefect:4200/api

# Notifications Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock_webhook_url
