# PostgreSQL Database
DATABASE_URL=postgresql://driftguard:<DB_PASSWORD>@postgres:5432/driftguard

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=driftguard-production

# Artifact Storage
DRIFTGUARD_ARTIFACT_ROOT=s3://driftguard-prod-artifacts-yugen

# AWS Region (Credentials are handled by EC2 IAM role, DO NOT set access keys here)
AWS_DEFAULT_REGION=ap-south-1

# DriftGuard Core Platform
DRIFTGUARD_API_URL=http://driftguard-api:8000
DRIFTGUARD_API_KEY=<YOUR_GENERATED_API_KEY>
DRIFTGUARD_DRIFT_THRESHOLD=0.15
DRIFTGUARD_RETRAIN_WINDOW_DAYS=30
