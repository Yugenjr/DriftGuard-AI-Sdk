# PostgreSQL Database
DATABASE_URL=postgresql://driftguard:<DB_PASSWORD>@localhost:5432/driftguard

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=driftguard-production

# Artifact Storage
# Change to your real S3 bucket (e.g., s3://driftguard-prod-models-bucket)
DRIFTGUARD_ARTIFACT_ROOT=s3://<YOUR_BUCKET_NAME>

# AWS Credentials (Use IAM Roles on EC2 where possible instead of hardcoding)
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
AWS_DEFAULT_REGION=us-east-1

# DriftGuard Core Platform
DRIFTGUARD_API_URL=http://localhost:8000
DRIFTGUARD_API_KEY=<YOUR_GENERATED_API_KEY>
DRIFTGUARD_DRIFT_THRESHOLD=0.15
DRIFTGUARD_RETRAIN_WINDOW_DAYS=30
